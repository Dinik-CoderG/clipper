# Copy this file to .env and fill in what you use. Never commit .env.
# server/daily.py loads .env by itself; run.ps1 and the reels\ scripts read the same names from the environment.

# Claude picks the moments (optional: without it a built-in scorer is used)
ANTHROPIC_API_KEY=
# YouTube Data API v3 key, needed only for the daily trending job (server/daily.py)
YOUTUBE_API_KEY=

# Optional overrides: uncomment only the ones you set (an empty value overrides the default)
# CLIPPER_MODEL=
# CLIPPER_WHISPER_MODEL=
# CLIPPER_DEVICE=
# CLIPPER_ENCODER=
# CLIPPER_VOICE_PY=
